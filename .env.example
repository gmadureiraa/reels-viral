# ── APIs externas ────────────────────────────────────────────────────────────
# Apify — scraping de Reels Instagram (apify~instagram-scraper)
APIFY_API_KEY=

# Gemini 2.5 Flash — transcrição de vídeo + geração de roteiro
GEMINI_API_KEY=

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Connection string com pooler — projeto Neon "Reels Viral"
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth ────────────────────────────────────────────────────────────────
# URL pública do Neon Auth (consumida pelo client) + JWKS pra validar JWT no server
NEXT_PUBLIC_NEON_AUTH_URL=https://HOST.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://HOST.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ── Neon Data API (opcional) ─────────────────────────────────────────────────
NEXT_PUBLIC_NEON_DATA_API=https://HOST.apirest.REGION.aws.neon.tech/neondb/rest/v1
