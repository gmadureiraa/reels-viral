# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ REELS VIRAL — variáveis de ambiente (preencher em .env.local + Vercel)     ║
# ║ Nunca commitar valores reais. Só chaves vazias aqui.                       ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── APIs externas (OBRIGATÓRIO pro pipeline) ─────────────────────────────────
# Apify — scraping de Reels Instagram (apify~instagram-scraper) + TikTok
APIFY_API_KEY=

# Gemini 2.5 Flash — transcrição de vídeo + geração de roteiro
GEMINI_API_KEY=

# ── Neon Postgres (OBRIGATÓRIO pra persistência logada) ──────────────────────
# Connection string com pooler — projeto Neon "Reels Viral".
# Sem isso, o app roda em modo guest (localStorage only).
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth (OBRIGATÓRIO pra login + quota/paywall) ────────────────────────
# URL pública do Neon Auth (client) + JWKS pra validar JWT no server.
NEXT_PUBLIC_NEON_AUTH_URL=https://HOST.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://HOST.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Opcionais — quando setados, o jwtVerify fica strict (issuer/audience).
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# ── Stripe (billing — planos Basic/Max) ──────────────────────────────────────
STRIPE_SECRET_KEY=
# Webhook secret. STRIPE_WEBHOOK_SECRET_RV tem precedência sobre o genérico.
STRIPE_WEBHOOK_SECRET_RV=
STRIPE_WEBHOOK_SECRET=
# Price IDs dos planos (Stripe Dashboard → Products)
STRIPE_PRICE_RV_BASIC_MONTH=
STRIPE_PRICE_RV_MAX_MONTH=

# ── Upstash Redis (rate-limit distribuído — recomendado em prod) ─────────────
# Sem isso, rate-limit cai pra Map in-memory (NÃO distribuído entre instâncias).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (emails: leads, automações, referral) ─────────────────────────────
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ── Cron jobs (idle-5d, lead-automation, power-user) ─────────────────────────
# Secret pra autenticar os crons do vercel.json (header Authorization).
CRON_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────────
# CSV de emails com acesso ao /app/admin (ex: gabriel@kaleidos.com.br,...)
ADMIN_EMAILS=

# ── Kill switches / cost guard ───────────────────────────────────────────────
# Truthy desabilita o pipeline (manutenção). Vazio/0/false = ativo.
RV_PIPELINE_DISABLED=
# Cap diário de custo em USD — acima dele, free+anon levam 503 (pagantes passam).
SOFT_DAILY_CAP_USD=

# ── Analytics ─────────────────────────────────────────────────────────────────
# PostHog (projeto "Kaleidos Group", host filtrado por $host)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# Google Analytics 4 — Measurement ID do stream web.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Site ──────────────────────────────────────────────────────────────────────
# URL canônica (usada em links de email, OG, redirects Stripe). Ex:
# https://reels-viral.vercel.app ou https://reels.kaleidos.com.br
NEXT_PUBLIC_SITE_URL=
